        <mxCell id="rag_service" value="services/rag_service.py&#xa;Import + cache existing pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=15;" vertex="1" parent="1"><mxGeometry x="360" y="195" width="185" height="80" as="geometry"/></mxCell>
